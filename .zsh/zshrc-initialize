# Ensure emacs mode for proper key bindings
bindkey -e
bindkey '^R' history-incremental-pattern-search-backward
bindkey -r '^T'

# auto pushd if cd.
setopt auto_pushd

# GCloud
source "/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/path.zsh.inc"
source "/opt/homebrew/Caskroom/google-cloud-sdk/latest/google-cloud-sdk/completion.zsh.inc"

# Alias
source ${HOME}/.zsh/modules/aliases.zsh

# Functions
source ${HOME}/.zsh/modules/functions.zsh


#### Initialize PATHS
# Volta
export VOLTA_HOME="$HOME/.volta"
export PATH="$VOLTA_HOME/bin:$PATH"

## Go
export GOPATH=$(go env GOPATH)
export PATH=$PATH:$GOPATH/bin

## pyenv
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
eval "$(pyenv init -)"

# SSL
export PATH="/opt/homebrew/opt/openssl@3/bin:$PATH"

# aqua
export PATH="$HOME/.local/share/aquaproj-aqua/bin:$PATH"

# Mise
eval "$(mise activate zsh)"

# zoxide
export _ZO_FZF_OPTS="
  --height=45%
  --border=rounded
  --layout=reverse
  --preview-window=right:50%
  --preview='ls -la --color=always \$(echo {} | awk \"{print \\\$NF}\") 2>/dev/null || echo \"Directory not found\"'
  --color=fg:#b3b5b5,bg:#1a2427,hl:#4fd0ca,fg+:#d1e7ca,bg+:#253133,hl+:#6bb6b0,info:#b3b5b5,prompt:#4fd0ca,pointer:#7dd3fc,marker:#86efac,spinner:#4fd0ca,border:#3f4f50
"

eval "$(zoxide init zsh)"

export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
eval "$(starship init zsh)"

# MySQL
export PATH="/opt/homebrew/opt/mysql@9.3/bin:$PATH"

# for Gemini
export GOOGLE_CLOLUD_LOCATION="asia-northeast1"
export GOOGLE_GENAI_USER_VERTEXAI=true

# About for Git Editor
export EDITOR=nvim

# LazyGit
export LAZYGIT_CONFIG_DIR="$HOME/.config/lazygit"

# SSL
export SSL_CERT_FILE=$(python3 -m certifi)

