# zplugの設定

is_ish_zplug() {
  [[ -f /etc/alpine-release || -f /proc/ish || -n "${ISH:-}" ]]
}

if [[ ! -d ~/.zplug ]];then
  git clone https://github.com/zplug/zplug ~/.zplug
fi

[[ -f ~/.zplug/init.zsh ]] || return 0
source ~/.zplug/init.zsh

if is_ish_zplug; then
  # iSH/Alpine safe set.
  # Avoid plugins that assume bash, GNU userland, gh-r, or heavy fzf integrations.
  zplug "zsh-users/zsh-completions"
  zplug "zsh-users/zsh-autosuggestions"
  zplug "zsh-users/zsh-history-substring-search"
else
  zplug "zsh-users/zsh-completions"
  zplug "plugins/git", from:oh-my-zsh
  zplug "peterhurford/git-aliases.zsh"
  zplug "plugins/pip", from:oh-my-zsh
  zplug "mattberther/zsh-pyenv"

  ########################## fzf
  # fzf でよく使う関数の詰め合わせ
  zplug "mollifier/anyframe"
  zplug "mollifier/cd-gitroot"
  # ディレクトリ移動を高速化（fzf であいまい検索）
  zplug "b4b4r07/enhancd", use:init.sh

  # git のローカルリポジトリを一括管理（fzf でリポジトリへジャンプ）
  # zplug "motemen/ghq", as:command, from:gh-r

  zplug "b4b4r07/zsh-gomi", as:command, use:bin

  zplug "zsh-users/zsh-autosuggestions"
  zplug "zsh-users/zsh-history-substring-search", defer:3

  zplug "zplug/zplug", hook-build:'zplug --self-manage'
fi

# 未インストール項目をインストールする
if ! zplug check --verbose; then
    printf "Install? [y/N]: "
    if read -q; then
        echo; zplug install
    fi
fi

# コマンドをリンクして、PATH に追加し、プラグインは読み込む
zplug load

if [[ -n "${LS_COLORS:-}" ]]; then
  zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
fi

